# Hitchhiking Map Project - Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_APP=hitch
FLASK_ENV=development

# Flask Secret Key (generate a new one for production)
SECRET_KEY=your_secret_key_here...can be anything

# Database Configuration
DATABASE_NAME=prod-points.sqlite

# Nostr Configuration
# Your private key (keep this private)
NSEC=your_nostr_private_key_here...nsecxxx

# We currently use the nomadwiki relay to act as a central point for fetching and storing points
# for testing you might use other public relays like "wss://nos.lol" or "wss://relay.damus.io"
RELAYS = ["wss://relay.nomadwiki.org"]


THIS_NOSTR_SOURCE=maps.hitchwiki.org
NOSTR_EVENT_KIND=36820

# Hitchwiki OAuth2 (for login via hitchwiki.org)
HITCHWIKI_OAUTH_CLIENT_ID = afd23fc3ac2d225d39de8b361e956aef # use aa159948f2af30b9c56bc106d19e6484 for local testing with callback url http://127.0.0.1:5001/login
# keep this private
HITCHWIKI_OAUTH_CLIENT_SECRET = xxx

# choose prod or dev
ENVIRONMENT=
