# Hitchhiking Map Project - Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_APP=hitch
FLASK_ENV=development

# Flask Secret Key (generate a new one for production)
SECRET_KEY=your_secret_key_here...can be anything

# Database Configuration
DATABASE_NAME=hitchhiking-prod.sqlite

# Nostr Configuration
# Your private key (keep this private)
# TODO
NSEC=your_nostr_private_key_here...nsecxxx

# We currently use the maps.hitchwiki.org relay to act as a central point for fetching and storing points
# for testing you might use other public relays like "wss://nos.lol" or "wss://relay.damus.io"
RELAYS = ["wss://relay.maps.hitchwiki.org"]


THIS_NOSTR_SOURCE=maps.hitchwiki.org
THIS_DATA_LICENSE=odbl
NOSTR_EVENT_KIND=36820

# Hitchwiki OAuth2 (for login via hitchwiki.org)
HITCHWIKI_OAUTH_CLIENT_ID = afd23fc3ac2d225d39de8b361e956aef # use aa159948f2af30b9c56bc106d19e6484 for local testing with callback url http://127.0.0.1:5001/login
# keep this private
HITCHWIKI_OAUTH_CLIENT_SECRET = xxx

# Tunnel-based OAuth testing (cloudflared / ngrok). The consumer's registered callback is
# compared byte-for-byte, and url_for() would derive the tunnel's random hostname, which is
# registered nowhere. Pin the exact origin here and register "<that origin>/login" as the
# consumer's callback. Leave unset for normal local (127.0.0.1) and production use.
# HITCHWIKI_OAUTH_REDIRECT_BASE = https://your-tunnel.trycloudflare.com
# HITCHWIKI_OAUTH_REDIRECT_SCHEME = https

# choose prod or dev
# TODO
ENVIRONMENT=xxx

# choose production or development (config class in hitch/settings.py)
FLASK_CONFIG=development

# only with write access to https://huggingface.co/datasets/Hitchwiki/hitchhiking-rides-dataset
HF_TOKEN=hf_xxx

# Weekly scrubbed DB backup to Google Drive (hitch/scripts/backup_to_drive.py).
# Requires deploy/rclone.conf — see deploy/rclone.conf.example for how to generate the token.
# Leave BACKUP_RCLONE_REMOTE unset to disable the backup (the cron job then exits non-zero).
BACKUP_RCLONE_REMOTE=gdrive:hitchmap-backups
BACKUP_RETENTION_DAYS=28

# SparkPost email (first-login welcome email) — shared with hitchhiking-newsletter
SPARKPOST_API_KEY=your-sparkpost-api-key-here
SPARKPOST_BASE_URL=https://api.eu.sparkpost.com/api/v1
WELCOME_FROM_EMAIL=hi@hitchwiki.org
WELCOME_FROM_NAME=Hitchwiki Maps
