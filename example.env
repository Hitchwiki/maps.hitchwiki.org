# Hitchhiking Map Project - Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_APP=hitch
FLASK_ENV=development

# Secret Key (generate a new one for production)
SECRET_KEY=your_secret_key_here

# Database Configuration
DATABASE_NAME=prod-points.sqlite

# Nostr Configuration
# Your private key (keep this private)
NSEC=your_nostr_private_key_here

RELAYS = ["wss://relay.nomadwiki.org", "wss://relay.trustroots.org", "wss://nos.lol"]

THIS_NOSTR_SOURCE=maps.hitchwiki.org

OAUTH_CONSUMER_KEY = '6682a21ab84b6cebc2c4f0984b10769a'
# keep this private
OAUTH_CONSUMER_SECRET = 'xxx'

# choose prod or dev
ENVIRONMENT=
