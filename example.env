# Hitchhiking Map Project - Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_APP=hitch
FLASK_ENV=development

# Secret Key (generate a new one for production)
SECRET_KEY=your_secret_key_here

# Database Configuration
DATABASE_NAME=prod-points.sqlite

# Nostr Configuration
# Your private key (keep this private)
NSEC=your_nostr_private_key_here

# Nostr relays to connect to
RELAYS=["wss://relay.nomadwiki.org", "wss://relay.trustroots.org", "wss://nos.lol"]

# Source identifier for published data
THIS_NOSTR_SOURCE=maps.hitchwiki.org

# OAuth Configuration (for MediaWiki integration)
OAUTH_CONSUMER_KEY=your_oauth_consumer_key_here
OAUTH_CONSUMER_SECRET=your_oauth_consumer_secret_here
OAUTH_SECRET_KEY=your_oauth_secret_key_here

# Environment (prod/dev)
ENVIRONMENT=dev

# Email Configuration (optional)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
HITCHWIKI_MAIL_PASSWORD=your_hitchwiki_mail_password

# Security Configuration
SECURITY_PASSWORD_HASH=argon2
SECURITY_PASSWORD_SALT=your_password_salt_here

# Debug Configuration
FLASK_DEBUG=false
